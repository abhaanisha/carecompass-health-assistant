# Copy to .env (or set these as Hugging Face Space secrets).
# The app runs with NONE of these set - it falls back to extractive answers
# built from the retrieved passages.

# --- Model provider: set ONE. First one found wins, in this order. ---
# Groq and Cerebras need no credit card.
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=

# --- Overrides ---
# CARECOMPASS_PROVIDER=groq      # force a provider, or "none" to demo the fallback
# CARECOMPASS_MODEL=             # override that provider's default model
# CARECOMPASS_DISABLE_DENSE=1    # lexical-only retrieval, skips the torch download
# CARECOMPASS_DISABLE_LOGGING=1  # do not write the event log
# CARECOMPASS_LOG_DIR=/data/logs # persistent volume instead of the repo directory
# CARECOMPASS_TOP_K=5
# CARECOMPASS_TEMPERATURE=0.2
# CARECOMPASS_MAX_TOKENS=900
# CARECOMPASS_TIMEOUT=45
# CARECOMPASS_DEBUG=1
