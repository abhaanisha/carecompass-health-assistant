# Streamlit Community Cloud: paste this into
#   Manage app -> Settings -> Secrets
# Locally: copy to .streamlit/secrets.toml (which is gitignored).
#
# The app runs with none of these set, falling back to extractive answers.
# Set ONE key. Groq and Cerebras need no credit card.

GROQ_API_KEY = "gsk_..."

# CEREBRAS_API_KEY = "csk-..."
# GEMINI_API_KEY   = "AIza..."
# OPENAI_API_KEY   = "sk-..."

# CARECOMPASS_MODEL = "openai/gpt-oss-120b"
